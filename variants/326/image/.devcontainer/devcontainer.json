{
  // ================================================================
  // Image definition for ghcr.io/timdrichards/gantry-326.
  //
  // Not shipped to students. The build workflow runs the Dev
  // Containers CLI on this file, which builds the Dockerfile AND bakes
  // the features below into the image, recording them in the image's
  // devcontainer.metadata label. A student's Codespace then pulls the
  // finished image and installs nothing at start-up.
  // ================================================================
  "name": "Gantry 326 (image build)",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    // Docker CLI + compose for `dc-up mongo`, against the host daemon.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "enableNonRootDocker": "true",
      "moby": "false"
    },
    // sshd: only so `gh codespace ssh` can reach the container.
    "ghcr.io/devcontainers/features/sshd:1": { "version": "latest" }
  },
  "remoteUser": "vscode"
}
