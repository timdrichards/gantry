# ---- Git wrapper: identity before commits, gh auth before push --
git() {
  local subcommand=""
  for arg in "$@"; do
    [[ "$arg" != -* ]] && { subcommand="$arg"; break; }
  done

  case "$subcommand" in
    commit|merge|rebase|cherry-pick|revert|tag|stash|am)
      if [[ -z "$(command git config user.name 2>/dev/null)" || -z "$(command git config user.email 2>/dev/null)" ]]; then
        echo ""
        echo "  Git identity is not configured. Run:"
        echo ""
        echo '    git config --global user.name  "Your Name"'
        echo '    git config --global user.email "you@example.com"'
        echo ""
        return 1
      fi
      ;;
    push|pull|fetch)
      # Codespaces signs git in for you; elsewhere gh does.
      if [[ -z "${CODESPACES:-}" ]] && ! gh auth status &>/dev/null; then
        echo ""
        echo "  GitHub CLI is not signed in, so git can't reach GitHub yet. Run:"
        echo ""
        echo "    gh auth login"
        echo ""
        echo "  You only need to do this once; it survives restarts and rebuilds."
        echo ""
        return 1
      fi
      ;;
  esac

  command git "$@"
}

