# ---- Prompt (git branch + node version) ------------------------
__git_branch() {
  git rev-parse --abbrev-ref HEAD 2>/dev/null | sed 's/.*/ (\0)/'
}
__node_ver() {
  node --version 2>/dev/null | sed 's/v//'
}
PS1='\[\e[0;36m\]\u\[\e[0m\]@\[\e[0;33m\]devcontainer\[\e[0m\]:\[\e[0;34m\]\w\[\e[0;35m\]$(__git_branch)\[\e[0m\] \[\e[0;32m\][node $(__node_ver)]\[\e[0m\]\n\$ '

# ---- Persistent bash history -----------------------------------
export HISTFILE=/commandhistory/.bash_history
export HISTSIZE=10000
export HISTFILESIZE=20000
export HISTCONTROL=ignoredups:erasedups
shopt -s histappend

# ---- MongoDB and the other compose services --------------------
# Outside Codespaces, also layer in compose.local-ports.yml so MongoDB
# is on localhost:27017. In Codespaces the port forwarder would collide
# with a published port, so it is left out there.
dc() {
  local -a files=(-f /gantry/.devcontainer/compose.yml)
  [[ -z "${CODESPACES:-}" ]] && files+=(-f /gantry/.devcontainer/compose.local-ports.yml)
  local project
  project="$(basename "$(echo "${LOCAL_WORKSPACE_FOLDER}" | tr '\\' '/')")_devcontainer"
  docker compose "${files[@]}" --project-name "$project" "$@"
}
# Naming a service starts it even though it sits behind a profile.
dc-up()   { dc up -d --wait "${@:?usage: dc-up <service>}"; }
# Stops MongoDB (or the services you name), never this container.
dc-down() { dc stop "${@:-mongo}"; }
dc-logs() { dc logs -f "$@"; }
alias dps='docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"'

# Open a shell in a running service container: dexb mongo
dexb() {
  local service="${1:?usage: dexb <service>}"
  local container
  container=$(docker ps --filter "label=com.docker.compose.service=${service}" --format "{{.Names}}" | head -1)
  if [[ -z "$container" ]]; then
    echo "dexb: '${service}' is not running. Start it with: dc-up ${service}" >&2
    return 1
  fi
  docker exec -it "$container" bash 2>/dev/null || docker exec -it "$container" sh
}

# MongoDB shell. mongosh runs inside the mongo container, so it does
# not need to be installed in this one.
mongo-dev() {
  local container
  container=$(docker ps --filter "label=com.docker.compose.service=mongo" --format "{{.Names}}" | head -1)
  if [[ -z "$container" ]]; then
    echo "mongo-dev: MongoDB is not running. Start it with: dc-up mongo" >&2
    return 1
  fi
  local tty=-i; [[ -t 0 ]] && tty=-it
  docker exec "$tty" "$container" mongosh "mongodb://dev:devpassword@localhost:27017/devdb?authSource=admin" "$@"
}

