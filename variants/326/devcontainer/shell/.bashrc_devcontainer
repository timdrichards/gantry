# ---- cargo-update: pull in template updates in one step ---------
cargo-update() {
  if ! git -C /gantry remote get-url upstream &>/dev/null; then
    echo "No 'upstream' remote is configured, so there's nothing to update from here." >&2
    return 1
  fi
  echo "Checking for updates..."
  if ! git -C /gantry fetch upstream --quiet; then
    echo "Couldn't reach the course template (check your network). Try again in a bit." >&2
    return 1
  fi
  local behind
  behind=$(git -C /gantry rev-list --count HEAD..upstream/main 2>/dev/null || echo 0)
  if [[ "$behind" -eq 0 ]]; then
    echo "You're already up to date."
    return 0
  fi
  echo "Found ${behind} update(s). Applying them..."
  if git -C /gantry merge upstream/main --no-edit; then
    echo ""
    echo "✅ Updated. If VS Code offers 'Rebuild Container', click it to finish."
    echo "   Otherwise run 'Dev Containers: Rebuild Container' from the Command Palette."
  else
    echo ""
    echo "⚠️  Merge conflict: git needs a person to pick which version of a file"
    echo "   to keep. You didn't break anything. Ask a TA if you're not sure."
    return 1
  fi
}

