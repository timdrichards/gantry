{
  // ================================================================
  // VS Code Dev Container — Web Programming & Scalable Web Systems
  // ================================================================
  "name": "Web Dev + Scalable Systems",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspace",

  // ----------------------------------------------------------------
  // Features — Docker-in-Docker (full DinD)
  // ----------------------------------------------------------------
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "enableNonRootDocker": "true",
      "moby": "false"
    }
  },

  // ----------------------------------------------------------------
  // VS Code Extensions + Settings
  // ----------------------------------------------------------------
  "customizations": {
    "vscode": {
      "extensions": [

        // ── TypeScript & JavaScript ────────────────────────────────
        // Official TS language service (nightly — always latest features)
        "ms-vscode.vscode-typescript-next",
        // ESLint integration — inline lint errors as you type
        "dbaeumer.vscode-eslint",
        // Prettier — opinionated code formatter
        "esbenp.prettier-vscode",
        // Import cost — shows bundle size of each import inline
        "wix.vscode-import-cost",
        // Auto-rename paired HTML/JSX tags
        "formulahendry.auto-rename-tag",
        // Auto-close HTML tags
        "formulahendry.auto-close-tag",
        // Path IntelliSense — autocomplete file paths in import statements
        "christian-kohler.path-intellisense",
        // npm IntelliSense — autocomplete node_modules in import statements
        "christian-kohler.npm-intellisense",
        // npm script runner sidebar
        "eg2.vscode-npm-script",
        // Inline type hints and parameter names
        "nrwl.angular-console",

        // ── Frontend / CSS ─────────────────────────────────────────
        // Tailwind CSS IntelliSense — class autocomplete, hover previews
        "bradlc.vscode-tailwindcss",
        // PostCSS language support
        "csstools.postcss",
        // Styled-components syntax highlighting + IntelliSense
        "styled-components.vscode-styled-components",
        // Color highlight — shows color swatches inline in CSS/JS
        "naumovs.color-highlight",
        // Color picker — click any color value to open a picker
        "anseki.vscode-color",
        // CSS variable autocomplete
        "phoenisx.cssvar",

        // ── HTML / Templating ──────────────────────────────────────
        // HTMX attribute IntelliSense (used in CS 326 stack)
        "otovo-oss.htmx-tags",
        // Emmet is built-in; this extends it for JSX
        "baldurk.emmet-jsx",
        // Highlight matching HTML tags
        "vincaslt.highlight-matching-tag",
        // Better HTML language features
        "mkaufman.htmlhint",

        // ── Node.js / Backend ──────────────────────────────────────
        // Node.js module IntelliSense for require/import
        "leizongmin.node-module-intellisense",
        // DotENV — syntax highlighting for .env files
        "mikestead.dotenv",
        // Prisma schema language support + formatting
        "Prisma.prisma",
        // PM2 process manager sidebar
        "technomancy.pm2",

        // ── Database Clients ───────────────────────────────────────
        // Database client — PostgreSQL, MySQL, SQLite, Redis in one panel
        "cweijan.vscode-database-client2",
        // MongoDB — official extension (Playgrounds, schema view, CRUD)
        "mongodb.mongodb-vscode",
        // SQLite viewer for .sqlite / .db files
        "qwtel.sqlite-viewer",
        // Prisma ERD visualizer
        "daniel-b.prisma-preview",

        // ── HTTP / API Testing ─────────────────────────────────────
        // REST Client — send .http files directly from the editor
        "humao.rest-client",
        // Thunder Client — lightweight Postman alternative built into VS Code
        "rangav.vscode-thunder-client",
        // OpenAPI / Swagger preview and editing
        "42crunch.vscode-openapi",
        // GraphQL syntax highlighting + schema IntelliSense
        "GraphQL.vscode-graphql",
        "GraphQL.vscode-graphql-syntax",

        // ── Docker & Containers ────────────────────────────────────
        // Official Docker extension — image/container management, Dockerfile IntelliSense
        "ms-azuretools.vscode-docker",
        // Docker Compose syntax highlighting and IntelliSense
        "p1c2u.docker-compose",
        // Kubernetes (handy if you scale up to k8s)
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        // Remote Containers (already present outside container, useful reference)
        "ms-vscode-remote.remote-containers",

        // ── Git & Version Control ──────────────────────────────────
        // GitLens — blame, history, PR decorations, powerful git UI
        "eamodio.gitlens",
        // Git Graph — visualise branch topology
        "mhutchie.git-graph",
        // Git History — file and line history
        "donjayamanne.githistory",
        // GitHub Pull Requests — review PRs without leaving VS Code
        "GitHub.vscode-pull-request-github",
        // GitHub Copilot (optional — students may have student pack access)
        // "GitHub.copilot",

        // ── Testing ───────────────────────────────────────────────
        // Vitest — inline test results and coverage
        "vitest.explorer",
        // Jest — runner for projects using Jest
        "Orta.vscode-jest",
        // Test Explorer UI — unified sidebar for all test frameworks
        "hbenl.vscode-test-explorer",
        // Coverage Gutters — shows line coverage in the gutter
        "ryanluker.vscode-coverage-gutters",

        // ── Debugging ─────────────────────────────────────────────
        // Node.js debug auto-attach (built-in, surfaced here for awareness)
        // JavaScript Debugger is bundled; these extend it:
        // Browser preview — debug Chrome/Edge directly inside VS Code
        "ms-edgedevtools.vscode-edge-devtools",

        // ── Code Quality & Linting ─────────────────────────────────
        // Error Lens — shows errors/warnings inline at end of the line
        "usernamehw.errorlens",
        // SonarLint — detects bugs and code smells as you type
        "SonarSource.sonarlint-vscode",
        // Code Spell Checker — catches typos in identifiers, comments, strings
        "streetsidesoftware.code-spell-checker",
        // TODO Tree — aggregates TODO/FIXME/HACK comments into a sidebar panel
        "gruntfuggly.todo-tree",

        // ── Performance & Profiling ────────────────────────────────
        // Flame graph / CPU profiler viewer for Node.js .cpuprofile files
        "ms-vscode.vscode-js-profile-flame",

        // ── Data Formats ───────────────────────────────────────────
        // YAML — IntelliSense, validation, formatting (docker-compose, k8s, CI)
        "redhat.vscode-yaml",
        // TOML syntax highlighting
        "tamasfe.even-better-toml",
        // Rainbow CSV — colorizes CSV/TSV columns, supports SQL-like queries
        "mechatroner.rainbow-csv",
        // JSON schema validation and IntelliSense (extends built-in)
        "ZainChen.one-json",
        // Paste JSON as TypeScript types
        "quicktype.quicktype",

        // ── Shell & Terminal ───────────────────────────────────────
        // Bash IDE — language server for shell scripts (shellcheck integration)
        "mads-hartmann.bash-ide-vscode",
        // ShellCheck — shell script linting
        "timonwong.shellcheck",
        // Shell Format — shfmt formatter for bash/sh scripts
        "foxundermoon.shell-format",

        // ── Markdown & Documentation ───────────────────────────────
        // Markdown All-in-One — shortcuts, TOC generation, preview
        "yzhang.markdown-all-in-one",
        // Mermaid diagrams in Markdown preview
        "bierner.markdown-mermaid",
        // Mermaid diagram editor with live preview
        "tomoyukim.vscode-mermaid-editor",

        // ── Productivity & UI ──────────────────────────────────────
        // Material Icon Theme — distinctive icons for every file type
        "PKief.material-icon-theme",
        // Indent Rainbow — colorizes indentation levels
        "oderwat.indent-rainbow",
        // Bracket Pair Colorizer (built into VS Code since 1.67 — enable via setting)
        // Project Manager — switch between projects quickly
        "alefragnani.project-manager",
        // Live Share — real-time collaborative editing (great for pair programming)
        "ms-vsliveshare.vsliveshare",
        // Better Comments — color-coded comment annotations (!, ?, TODO, *)
        "aaron-bond.better-comments",
        // Bookmarks — mark lines and jump between them
        "alefragnani.bookmarks",
        // Output Colorizer — adds color to VS Code's Output panel logs
        "IBM.output-colorizer"

      ],

      // ── Settings ─────────────────────────────────────────────────
      "settings": {

        // Terminal
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.fontSize": 13,
        "terminal.integrated.scrollback": 5000,

        // Editor — core
        "editor.fontSize": 13,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.wordWrap": "on",
        "editor.minimap.enabled": false,
        "editor.rulers": [100],
        "editor.cursorBlinking": "smooth",
        "editor.smoothScrolling": true,
        "editor.linkedEditing": true,
        "editor.bracketPairColorization.enabled": true,
        "editor.guides.bracketPairs": "active",

        // Formatting
        "editor.formatOnSave": true,
        "editor.formatOnPaste": false,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[javascriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[jsonc]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[css]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[html]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[markdown]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.wordWrap": "on"
        },
        "[yaml]": {
          "editor.defaultFormatter": "redhat.vscode-yaml",
          "editor.tabSize": 2
        },
        "[shellscript]": {
          "editor.defaultFormatter": "foxundermoon.shell-format"
        },
        "[prisma]": {
          "editor.defaultFormatter": "Prisma.prisma"
        },

        // TypeScript
        "typescript.preferences.importModuleSpecifier": "relative",
        "typescript.updateImportsOnFileMove.enabled": "always",
        "typescript.suggest.autoImports": true,
        "typescript.inlayHints.parameterNames.enabled": "literals",
        "typescript.inlayHints.variableTypes.enabled": false,
        "typescript.inlayHints.functionLikeReturnTypes.enabled": true,

        // JavaScript
        "javascript.updateImportsOnFileMove.enabled": "always",
        "javascript.suggest.autoImports": true,

        // ESLint
        "eslint.enable": true,
        "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
        "eslint.run": "onType",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },

        // Docker
        "docker.host": "unix:///var/run/docker.sock",
        "docker.showStartPage": false,

        // Git
        "git.autofetch": true,
        "git.enableSmartCommit": true,
        "git.confirmSync": false,
        "gitlens.currentLine.enabled": true,
        "gitlens.hovers.currentLine.over": "line",
        "gitlens.codeLens.enabled": false,

        // File handling
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "files.trimFinalNewlines": true,
        "files.exclude": {
          "**/node_modules": true,
          "**/.git": true,
          "**/dist": true,
          "**/.cache": true
        },
        "search.exclude": {
          "**/node_modules": true,
          "**/dist": true,
          "**/.cache": true
        },

        // Explorer
        "explorer.confirmDelete": false,
        "explorer.confirmDragAndDrop": false,
        "workbench.iconTheme": "material-icon-theme",

        // REST Client
        "rest-client.environmentVariables": {
          "$shared": {
            "baseUrl": "http://localhost:3000",
            "contentType": "application/json"
          },
          "dev": {
            "host": "localhost",
            "port": "3000"
          }
        },

        // Tailwind CSS
        "tailwindCSS.includeLanguages": {
          "javascript": "javascript",
          "typescript": "typescript",
          "html": "html"
        },
        "tailwindCSS.experimental.classRegex": [
          ["clsx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"],
          ["cn\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
        ],

        // Color highlight
        "color-highlight.enable": true,
        "color-highlight.markerType": "dot-before",

        // Error Lens
        "errorLens.enabledDiagnosticLevels": ["error", "warning"],
        "errorLens.delay": 500,

        // TODO Tree
        "todo-tree.general.tags": ["BUG", "HACK", "FIXME", "TODO", "XXX", "NOTE", "[ ]", "[x]"],
        "todo-tree.highlights.defaultHighlight": {
          "icon": "alert",
          "type": "text",
          "foreground": "#fff",
          "background": "#ffcc00",
          "opacity": 50,
          "iconColour": "#ffcc00"
        },

        // Better Comments
        "better-comments.tags": [
          { "tag": "!", "color": "#FF2D00", "strikethrough": false, "underline": false, "backgroundColor": "transparent", "bold": false, "italic": false },
          { "tag": "?", "color": "#3498DB", "strikethrough": false, "underline": false, "backgroundColor": "transparent", "bold": false, "italic": false },
          { "tag": "//", "color": "#474747", "strikethrough": true, "underline": false, "backgroundColor": "transparent", "bold": false, "italic": false },
          { "tag": "todo", "color": "#FF8C00", "strikethrough": false, "underline": false, "backgroundColor": "transparent", "bold": false, "italic": false },
          { "tag": "*", "color": "#98C379", "strikethrough": false, "underline": false, "backgroundColor": "transparent", "bold": false, "italic": false }
        ],

        // Coverage Gutters
        "coverage-gutters.showLineCoverage": true,
        "coverage-gutters.showRulerCoverage": true,

        // Indent Rainbow
        "indentRainbow.colors": [
          "rgba(255,255,64,0.07)",
          "rgba(127,255,127,0.07)",
          "rgba(255,127,255,0.07)",
          "rgba(79,236,236,0.07)"
        ],

        // YAML (docker-compose, k8s, GitHub Actions)
        "yaml.schemas": {
          "https://json.schemastore.org/github-workflow.json": ".github/workflows/*.yml",
          "https://raw.githubusercontent.com/compose-spec/compose-spec/master/schema/compose-spec.json": "docker-compose*.yml"
        },
        "yaml.validate": true,

        // ShellCheck
        "shellcheck.enable": true,
        "shellcheck.run": "onType",

        // Spell checker
        "cSpell.words": [
          "devcontainer", "pnpm", "htmx", "prisma", "esbuild",
          "vite", "vitest", "nodemon", "dotenv", "grpcurl",
          "websocat", "mongosh", "healthcheck", "composefile"
        ]
      }
    }
  },

  // ----------------------------------------------------------------
  // Port forwards (add / remove as needed)
  // ----------------------------------------------------------------
  "forwardPorts": [
    3000,  // app default
    3001,  // app alt
    4000,  // GraphQL / API
    5000,  // Flask / misc
    5173,  // Vite
    8080,  // general HTTP
    8443,  // general HTTPS
    9090,  // Prometheus
    3306,  // MySQL
    5432,  // PostgreSQL
    6379,  // Redis
    27017, // MongoDB
    11211, // Memcached
    9200,  // Elasticsearch
    4369   // Erlang (RabbitMQ / BEAM)
  ],
  "portsAttributes": {
    "3000": { "label": "App (3000)", "onAutoForward": "notify" },
    "5173": { "label": "Vite Dev Server", "onAutoForward": "notify" },
    "8080": { "label": "HTTP Alt", "onAutoForward": "silent" },
    "9090": { "label": "Prometheus", "onAutoForward": "silent" }
  },

  // ----------------------------------------------------------------
  // Lifecycle scripts
  // ----------------------------------------------------------------
  "postCreateCommand": "bash /workspace/.devcontainer/scripts/post-create.sh",
  "postStartCommand": "bash /workspace/.devcontainer/scripts/post-start.sh",

  // ----------------------------------------------------------------
  // Remote user
  // ----------------------------------------------------------------
  "remoteUser": "vscode",
  "containerEnv": {
    "DOCKER_BUILDKIT": "1",
    "COMPOSE_DOCKER_CLI_BUILD": "1",
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
  }
}
