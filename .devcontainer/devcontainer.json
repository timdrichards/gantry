{
  // ================================================================
  // VS Code Dev Container — Gantry
  // ================================================================
  "name": "Gantry",
  "dockerComposeFile": "compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/gantry",

  // ----------------------------------------------------------------
  // Features — Docker-in-Docker (full DinD)
  // ----------------------------------------------------------------
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "enableNonRootDocker": "true",
      "moby": "false"
    }
  },

  // ----------------------------------------------------------------
  // VS Code Extensions + Settings
  // ----------------------------------------------------------------
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.vscode-typescript-next",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "wix.vscode-import-cost",
        "formulahendry.auto-rename-tag",
        "formulahendry.auto-close-tag",
        "christian-kohler.path-intellisense",
        "christian-kohler.npm-intellisense",
        "bradlc.vscode-tailwindcss",
        "csstools.postcss",
        "styled-components.vscode-styled-components",
        "naumovs.color-highlight",
        "anseki.vscode-color",
        "phoenisx.cssvar",
        "otovo-oss.htmx-tags",
        "baldurk.emmet-jsx",
        "vincaslt.highlight-matching-tag",
        "leizongmin.node-module-intellisense",
        "mikestead.dotenv",
        "Prisma.prisma",
        "technomancy.pm2",
        "cweijan.vscode-database-client2",
        "mongodb.mongodb-vscode",
        "qwtel.sqlite-viewer",
        "daniel-b.prisma-preview",
        "humao.rest-client",
        "rangav.vscode-thunder-client",
        "42crunch.vscode-openapi",
        "GraphQL.vscode-graphql",
        "GraphQL.vscode-graphql-syntax",
        "ms-azuretools.vscode-docker",
        "p1c2u.docker-compose",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "ms-vscode-remote.remote-containers",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "donjayamanne.githistory",
        "GitHub.vscode-pull-request-github",
        "vitest.explorer",
        "Orta.vscode-jest",
        "hbenl.vscode-test-explorer",
        "ryanluker.vscode-coverage-gutters",
        "ms-edgedevtools.vscode-edge-devtools",
        "usernamehw.errorlens",
        "SonarSource.sonarlint-vscode",
        "streetsidesoftware.code-spell-checker",
        "gruntfuggly.todo-tree",
        "ms-vscode.vscode-js-profile-flame",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "mechatroner.rainbow-csv",
        "ZainChen.one-json",
        "quicktype.quicktype",
        "mads-hartmann.bash-ide-vscode",
        "timonwong.shellcheck",
        "foxundermoon.shell-format",
        "yzhang.markdown-all-in-one",
        "bierner.markdown-mermaid",
        "tomoyukim.vscode-mermaid-editor",
        "PKief.material-icon-theme",
        "oderwat.indent-rainbow",
        "alefragnani.project-manager",
        "ms-vsliveshare.vsliveshare",
        "aaron-bond.better-comments",
        "alefragnani.bookmarks",
        "IBM.output-colorizer",
        "HTMLHint.vscode-htmlhint"
      ],

      // ── Settings ─────────────────────────────────────────────────
      "settings": {
        // Terminal
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.fontSize": 13,
        "terminal.integrated.scrollback": 5000,

        // Editor — core
        "editor.fontSize": 13,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.wordWrap": "bounded",
        "editor.wordWrapColumn": 80,
        "editor.rulers": [80],
        "editor.minimap.enabled": false,
        "editor.cursorBlinking": "smooth",
        "editor.smoothScrolling": true,
        "editor.linkedEditing": true,
        "editor.bracketPairColorization.enabled": true,
        "editor.guides.bracketPairs": "active",

        // Formatting
        "editor.formatOnSave": true,
        "editor.formatOnPaste": false,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[typescriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[javascriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[html]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[markdown]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.wordWrap": "on"
        },
        "[yaml]": {
          "editor.defaultFormatter": "redhat.vscode-yaml",
          "editor.tabSize": 2
        },
        "[shellscript]": {
          "editor.defaultFormatter": "foxundermoon.shell-format"
        },
        "[prisma]": { "editor.defaultFormatter": "Prisma.prisma" },

        // TypeScript
        "typescript.preferences.importModuleSpecifier": "relative",
        "typescript.updateImportsOnFileMove.enabled": "always",
        "typescript.suggest.autoImports": true,
        "typescript.inlayHints.parameterNames.enabled": "literals",
        "typescript.inlayHints.variableTypes.enabled": false,
        "typescript.inlayHints.functionLikeReturnTypes.enabled": true,

        // JavaScript
        "javascript.updateImportsOnFileMove.enabled": "always",
        "javascript.suggest.autoImports": true,

        // ESLint
        "eslint.enable": true,
        "eslint.validate": [
          "javascript",
          "javascriptreact",
          "typescript",
          "typescriptreact"
        ],
        "eslint.run": "onType",
        "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" },

        // Docker
        "docker.host": "unix:///var/run/docker.sock",
        "docker.showStartPage": false,

        // Git
        "git.autofetch": true,
        "git.enableSmartCommit": true,
        "git.confirmSync": false,
        "gitlens.currentLine.enabled": true,
        "gitlens.hovers.currentLine.over": "line",
        "gitlens.codeLens.enabled": false,

        // File handling
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "files.trimFinalNewlines": true,
        "files.exclude": {
          "**/node_modules": true,
          "**/.git": true,
          "**/dist": true,
          "**/.cache": true,
          ".devcontainer": true,
          ".plugins": true
        },
        "search.exclude": {
          "**/node_modules": true,
          "**/dist": true,
          "**/.cache": true
        },

        // Explorer
        "explorer.confirmDelete": false,
        "explorer.confirmDragAndDrop": false,
        "workbench.iconTheme": "material-icon-theme",

        // REST Client
        "rest-client.environmentVariables": {
          "$shared": {
            "baseUrl": "http://localhost:3000",
            "contentType": "application/json"
          },
          "dev": { "host": "localhost", "port": "3000" }
        },

        // Tailwind CSS
        "tailwindCSS.includeLanguages": {
          "javascript": "javascript",
          "typescript": "typescript",
          "html": "html"
        },
        "tailwindCSS.experimental.classRegex": [
          ["clsx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"],
          ["cn\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
        ],

        // Color highlight
        "color-highlight.enable": true,
        "color-highlight.markerType": "dot-before",

        // Error Lens
        "errorLens.enabledDiagnosticLevels": ["error", "warning"],
        "errorLens.delay": 500,

        // TODO Tree
        "todo-tree.general.tags": [
          "BUG",
          "HACK",
          "FIXME",
          "TODO",
          "XXX",
          "NOTE",
          "[ ]",
          "[x]"
        ],
        "todo-tree.highlights.defaultHighlight": {
          "icon": "alert",
          "type": "text",
          "foreground": "#fff",
          "background": "#ffcc00",
          "opacity": 50,
          "iconColour": "#ffcc00"
        },

        // Better Comments
        "better-comments.tags": [
          {
            "tag": "!",
            "color": "#FF2D00",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
          },
          {
            "tag": "?",
            "color": "#3498DB",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
          },
          {
            "tag": "//",
            "color": "#474747",
            "strikethrough": true,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
          },
          {
            "tag": "todo",
            "color": "#FF8C00",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
          },
          {
            "tag": "*",
            "color": "#98C379",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
          }
        ],

        // Coverage Gutters
        "coverage-gutters.showLineCoverage": true,
        "coverage-gutters.showRulerCoverage": true,

        // Indent Rainbow
        "indentRainbow.colors": [
          "rgba(255,255,64,0.07)",
          "rgba(127,255,127,0.07)",
          "rgba(255,127,255,0.07)",
          "rgba(79,236,236,0.07)"
        ],

        // YAML (docker-compose, k8s, GitHub Actions)
        "yaml.schemas": {
          "https://json.schemastore.org/github-workflow.json": ".github/workflows/*.yml",
          "https://raw.githubusercontent.com/compose-spec/compose-spec/master/schema/compose-spec.json": "docker-compose*.yml"
        },
        "yaml.validate": true,

        // ShellCheck
        "shellcheck.enable": true,
        "shellcheck.run": "onType",

        // SonarLint — point at the JRE installed in the Dockerfile
        "sonarlint.ls.javaHome": "/usr/lib/jvm/default-java",

        // Spell checker
        "cSpell.words": [
          "devcontainer",
          "pnpm",
          "htmx",
          "prisma",
          "esbuild",
          "vite",
          "vitest",
          "nodemon",
          "dotenv",
          "grpcurl",
          "websocat",
          "mongosh",
          "healthcheck",
          "composefile"
        ]
      }
    }
  },

  // ----------------------------------------------------------------
  // Port forwards (add / remove as needed)
  // ----------------------------------------------------------------
  "forwardPorts": [
    3000, // app default
    3001, // app alt
    4000, // GraphQL / API
    5000, // Flask / misc
    5173, // Vite
    8080, // general HTTP
    8443, // general HTTPS
    9090, // Prometheus
    3306, // MySQL
    5432, // PostgreSQL
    6379, // Redis
    27017, // MongoDB
    11211, // Memcached
    9200, // Elasticsearch
    4369, // Erlang (RabbitMQ / BEAM)
    2019, // Caddy admin API
    1025, // Mailpit SMTP
    8025, // Mailpit web UI
    9000, // MinIO API
    9001, // MinIO console
    9092, // Redpanda Kafka API
    8081, // Redpanda Schema Registry
    8082, // Redpanda HTTP Proxy
    9644, // Redpanda Admin API
    9080, // Redpanda Console UI
    16686, // Jaeger UI
    4317, // Jaeger OTLP gRPC
    4318, // Jaeger OTLP HTTP
    8888 // Adminer
  ],
  "portsAttributes": {
    "3000": { "label": "App (3000)", "onAutoForward": "notify" },
    "5173": { "label": "Vite Dev Server", "onAutoForward": "notify" },
    "8080": { "label": "HTTP Alt", "onAutoForward": "silent" },
    "9090": { "label": "Prometheus", "onAutoForward": "silent" },
    "2019": { "label": "Caddy Admin API", "onAutoForward": "silent" },
    "8025": { "label": "Mailpit", "onAutoForward": "notify" },
    "9001": { "label": "MinIO Console", "onAutoForward": "notify" },
    "9080": { "label": "Redpanda Console", "onAutoForward": "notify" },
    "16686": { "label": "Jaeger UI", "onAutoForward": "notify" },
    "8888": { "label": "Adminer", "onAutoForward": "notify" }
  },

  // ----------------------------------------------------------------
  // Lifecycle scripts
  // ----------------------------------------------------------------
  "postCreateCommand": "bash /gantry/.devcontainer/scripts/post-create.sh",
  "postStartCommand": "bash /gantry/.devcontainer/scripts/post-start.sh",

  // ----------------------------------------------------------------
  // GitHub CLI auth — share host credentials into the container
  //
  // Mac/Linux: mounts ~/.config/gh so existing `gh auth login` on the
  //            host is available automatically inside the container.
  //
  // Windows:   gh stores auth in %APPDATA%\GitHub CLI, not ~/.config/gh,
  //            so the mount has no effect.  Instead set GH_TOKEN in your
  //            host environment (System → Environment Variables) and it
  //            will be forwarded here via remoteEnv.
  // ----------------------------------------------------------------
  "mounts": [
    // gh auth config — shares existing `gh auth login` from the host.
    // Uses HOME only (not USERPROFILE) to avoid double-concatenation on
    // Windows machines where Git for Windows sets both variables.
    // Windows users: ensure HOME=%USERPROFILE% is set (Git for Windows
    // does this automatically), or use the GH_TOKEN fallback in remoteEnv.
    "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind,consistency=cached",
    // SSH keys — needed for git push over SSH (git@github.com remotes).
    // post-start.sh normalises file permissions inside the container.
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached"
  ],

  // ----------------------------------------------------------------
  // Remote user
  // ----------------------------------------------------------------
  "remoteUser": "vscode",
  "containerEnv": {
    "DOCKER_BUILDKIT": "1",
    "COMPOSE_DOCKER_CLI_BUILD": "1",
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
  },
  "remoteEnv": { "GH_TOKEN": "${localEnv:GH_TOKEN}" }
}
