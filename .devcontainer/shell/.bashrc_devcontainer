# ---- Git wrapper — enforces identity + gh auth before relevant ops --
git() {
  # Find the first non-flag argument (the subcommand)
  local subcommand=""
  for arg in "$@"; do
    [[ "$arg" != -* ]] && { subcommand="$arg"; break; }
  done

  case "$subcommand" in
    commit|merge|rebase|cherry-pick|revert|tag|stash|am)
      local _name _email
      _name=$(command git config user.name 2>/dev/null)
      _email=$(command git config user.email 2>/dev/null)
      if [[ -z "$_name" || -z "$_email" ]]; then
        echo ""
        echo "  Git identity is not configured. Run:"
        echo ""
        echo '    git config --global user.name  "Your Name"'
        echo '    git config --global user.email "you@example.com"'
        echo ""
        echo "  This persists until the container is rebuilt."
        echo ""
        return 1
      fi
      ;;
  esac

  case "$subcommand" in
    push|pull|fetch)
      if ! gh auth status &>/dev/null; then
        echo ""
        echo "  GitHub CLI is not authenticated, so git can't reach GitHub yet. Run:"
        echo ""
        echo "    gh auth login"
        echo ""
        echo "  Then '${subcommand}' will work normally. This persists across"
        echo "  restarts and rebuilds, so you only need to do it once."
        echo ""
        return 1
      fi
      ;;
  esac

  command git "$@"
}

