# ---- User customization ----------------------------------------
# Edit /gantry/.bashrc.user to add your own aliases, variables,
# and functions. Run `reload-env` to apply changes in the current
# terminal without restarting the container.
_USER_BASHRC=/gantry/.bashrc.user
[[ -f "$_USER_BASHRC" ]] && source "$_USER_BASHRC"

reload-env() {
  if [[ -f /gantry/.bashrc.user ]]; then
    source /gantry/.bashrc.user
    echo "  Reloaded /gantry/.bashrc.user"
  else
    echo "  /gantry/.bashrc.user not found — nothing to reload."
  fi
  if [[ -f /gantry/.plugins/.loader.sh ]]; then
    source /gantry/.plugins/.loader.sh
    echo "  Reloaded plugin loader"
  fi
}

# ---- Plugin manager --------------------------------------------
plugin() {
  bash /gantry/.devcontainer/scripts/plugin-manager.sh "$@"
  local rc=$?
  if [[ $rc -eq 0 && ( "$1" == "install" || "$1" == "remove" || "$1" == "update" || "$1" == "new" ) ]]; then
    [[ -f /gantry/.plugins/.loader.sh ]] && source /gantry/.plugins/.loader.sh
  fi
  return $rc
}

