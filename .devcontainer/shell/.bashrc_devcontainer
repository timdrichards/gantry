# ---- Convenience aliases — Docker / Compose --------------------
alias d='docker'
# In Codespaces, skip the local host-port overlay entirely — Codespaces'
# own port-forwarding agent claims every port declared in any compose file
# it can see before a sidecar gets to publish it itself, which makes
# `dc-up <service>` fail with "address already in use". See
# compose.local-ports.yml for the full explanation.
dc() {
  local -a files=(-f /gantry/.devcontainer/compose.yml)
  [[ -z "${CODESPACES:-}" ]] && files+=(-f /gantry/.devcontainer/compose.local-ports.yml)
  local project
  project="$(basename "$(echo "${LOCAL_WORKSPACE_FOLDER}" | tr '\\' '/')")_devcontainer"
  docker compose "${files[@]}" --project-name "$project" "$@"
}
