# ================================================================
# .env.example — copy or rename to .env and adjust as needed
# All hostnames resolve inside the webdev Docker network
# ================================================================

NODE_ENV=development
PORT=3000

# PostgreSQL (service name: postgres)
DATABASE_URL="postgresql://dev:devpassword@postgres:5432/devdb"

# MongoDB (service name: mongo)
MONGO_URL="mongodb://dev:devpassword@mongo:27017/devdb?authSource=admin"

# Redis (service name: redis)
REDIS_URL="redis://redis:6379"

# MySQL (service name: mysql)
MYSQL_URL="mysql://dev:devpassword@mysql:3306/devdb"

# RabbitMQ (service name: rabbitmq)
AMQP_URL="amqp://dev:devpassword@rabbitmq:5672"

# Elasticsearch (service name: elasticsearch)
ELASTIC_URL="http://elastic:9200"

# Memcached (service name: memcached)
MEMCACHED_URL="memcached:11211"

# Mailpit — SMTP trap (service name: mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
MAILPIT_UI="http://mailpit:8025"

# MinIO — S3-compatible object storage (service name: minio)
MINIO_ENDPOINT="http://minio:9000"
MINIO_ROOT_USER=dev
MINIO_ROOT_PASSWORD=devpassword
AWS_ENDPOINT_URL="http://minio:9000"
AWS_ACCESS_KEY_ID=dev
AWS_SECRET_ACCESS_KEY=devpassword
AWS_DEFAULT_REGION=us-east-1

# Redpanda / Kafka (service name: redpanda)
KAFKA_BROKERS="redpanda:9092"
SCHEMA_REGISTRY_URL="http://redpanda:8081"

# Jaeger — distributed tracing (service name: jaeger)
# Send directly to Jaeger, or via the OTel Collector (otelcol:4317) for fan-out
OTEL_EXPORTER_OTLP_ENDPOINT="http://jaeger:4317"
OTEL_SERVICE_NAME=dev-app

# OpenTelemetry Collector (service name: otelcol) — fan-out to Jaeger + Prometheus + Loki
OTEL_COLLECTOR_GRPC="http://otelcol:4317"
OTEL_COLLECTOR_HTTP="http://otelcol:4318"

# Loki — log aggregation (service name: loki)
LOKI_URL="http://loki:3100"

# Qdrant — vector database (service name: qdrant)
QDRANT_URL="http://qdrant:6333"

# Meilisearch — full-text search (service name: meilisearch)
MEILISEARCH_URL="http://meilisearch:7700"
MEILISEARCH_MASTER_KEY=devmasterkey

# NATS (service name: nats)
NATS_URL="nats://nats:4222"

# Keycloak — OIDC identity provider (service name: keycloak)
KEYCLOAK_URL="http://keycloak:8180"
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=dev-app
OIDC_ISSUER="http://keycloak:8180/realms/master"

# Prometheus metrics (if using prom-client in your app)
METRICS_PORT=9091

# JWT / Auth (example — change in production!)
JWT_SECRET=supersecretdevkey
JWT_EXPIRES_IN=7d

# Session
SESSION_SECRET=anothersecretdevkey
